[Unit]
Description=AmazonOps SuperAgent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amazonops
Group=amazonops
WorkingDirectory=/opt/amazonops/current
Environment=AMAZONOPS_HOME=/var/lib/amazonops
EnvironmentFile=/opt/amazonops/config/service.env
ExecStart=/opt/amazonops/tooling/node-v24.22.1-linux-x64/bin/node scripts/start.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/amazonops
RestrictSUIDSGID=true
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
